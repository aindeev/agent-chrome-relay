#!/usr/bin/env bash
# Builds Chrome Relay Approve and installs it on your iPhone: ./ios/build [--simulator] [--no-push]
#
# Needs Xcode and xcodegen (`brew install xcodegen`). Signs with your Apple Development team: $CHROME_RELAY_IOS_TEAM,
# or the team of your Apple Development certificate if there is just one. Apple push needs the paid Apple Developer
# Program; with a free Apple ID add --no-push (notifications then come through the ntfy app, and the app stops
# opening after 7 days: run this again). Connect the iPhone by cable or the same Wi-Fi, with Developer Mode on.
set -euo pipefail
cd "$(dirname "$0")"
die() { echo "ios/build: $*" >&2; exit 1; }
command -v xcodegen >/dev/null || die "needs xcodegen: brew install xcodegen"

team=${CHROME_RELAY_IOS_TEAM:-}
if [ -z "$team" ]; then
  teams=$(security find-certificate -a -c "Apple Development" -p 2>/dev/null | awk '/BEGIN/{c=""} {c=c $0 "\n"} /END/{printf "%s", c | "openssl x509 -noout -subject"; close("openssl x509 -noout -subject")}' |
    sed -n 's/.*OU *= *\([A-Z0-9]\{10\}\).*/\1/p' | sort -u)
  [ "$(printf '%s\n' "$teams" | sed '/^$/d' | wc -l | tr -d ' ')" = 1 ] || die "pick your team: CHROME_RELAY_IOS_TEAM=<team id> ./ios/build (yours: $(echo $teams))"
  team=$teams
fi
export CHROME_RELAY_IOS_TEAM=$team
push=1 sim=""
for a in "$@"; do case "$a" in --no-push) push="" ;; --simulator) sim=1 ;; *) die "unknown argument $a" ;; esac; done
export CHROME_RELAY_IOS_ENTITLEMENTS=""
[ -n "$push" ] && [ -z "$sim" ] && export CHROME_RELAY_IOS_ENTITLEMENTS="Approve/Push.entitlements"
export CHROME_RELAY_IOS_BUNDLE_ID=${CHROME_RELAY_IOS_BUNDLE_ID:-dev.chromerelay.approve.$(echo "$team" | tr 'A-Z' 'a-z')}
xcodegen generate --quiet

if [ -n "$sim" ]; then
  xcodebuild -project Approve.xcodeproj -scheme Approve -destination 'generic/platform=iOS Simulator' -quiet build
  echo "built for the simulator (the Secure Enclave and Face ID need a real iPhone)"
  exit 0
fi
device=$(xcrun devicectl list devices 2>/dev/null | awk '/iPhone/ && /available/ {for (i=1;i<=NF;i++) if ($i ~ /^[0-9A-F-]{36}$/) print $i}' | head -1)
[ -n "$device" ] || die "no iPhone available: connect it (cable or same Wi-Fi), unlock it, and turn on Settings > Privacy & Security > Developer Mode"
udid=$(xcrun devicectl device info details --device "$device" 2>/dev/null | sed -n 's/.* udid: *//p' | head -1)
# a free Apple ID gets a profile only for registered devices: Xcode registers this one
xcodebuild -project Approve.xcodeproj -scheme Approve -destination "platform=iOS,id=$udid" -configuration Release \
  -derivedDataPath .derived -allowProvisioningUpdates -allowProvisioningDeviceRegistration -quiet build
xcrun devicectl device install app --device "$device" ".derived/Build/Products/Release-iphoneos/Chrome Relay Approve.app"
echo "installed on your iPhone. First launch: Settings > General > VPN & Device Management > trust your developer certificate."
